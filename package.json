{
  "name": "unutils",
  "version": "0.0.0",
  "description": "A big collection of utilities coming from different utility libraries and us, targeting modern environments.",
  "keywords": [
    "utils",
    "util",
    "utilities",
    "utility",
    "stdlib",
    "es-toolkit"
  ],
  "homepage": "https://github.com/andreww2012/unutils",
  "bugs": {
    "url": "https://github.com/andreww2012/unutils/issues/new"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreww2012/unutils.git"
  },
  "license": "MIT",
  "author": "andreww2012",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./array": {
      "types": "./dist/array/index.d.mts",
      "default": "./dist/array/index.mjs"
    },
    "./function": {
      "types": "./dist/function/index.d.mts",
      "default": "./dist/function/index.mjs"
    },
    "./iterable": {
      "types": "./dist/iterable/index.d.mts",
      "default": "./dist/iterable/index.mjs"
    },
    "./math": {
      "types": "./dist/math/index.d.mts",
      "default": "./dist/math/index.mjs"
    },
    "./misc": {
      "types": "./dist/misc/index.d.mts",
      "default": "./dist/misc/index.mjs"
    },
    "./predicate": {
      "types": "./dist/predicate/index.d.mts",
      "default": "./dist/predicate/index.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.mts",
      "default": "./dist/runtime/index.mjs"
    },
    "./string": {
      "types": "./dist/string/index.d.mts",
      "default": "./dist/string/index.mjs"
    },
    "./value": {
      "types": "./dist/value/index.d.mts",
      "default": "./dist/value/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "u": "ncu",
    "u:m": "ncu -t minor",
    "u:pm": "ncu --dep packageManager",
    "deps:audit": "pnpm audit --audit-level high",
    "deps:dedupe-check": "pnpm dedupe --check",
    "deps:peers-check": "pnpm peers check",
    "deps:check": "nr deps:peers-check && nr deps:audit",
    "deps:check:strict": "nr deps:dedupe-check && nr deps:check",
    "spellcheck": "cspell --no-progress --no-summary .",
    "format:check": "prettier --check . --log-level warn",
    "format:fix": "prettier --write . --log-level warn",
    "eslint:inspect": "eslint-config-inspector --open false",
    "lint:eslint": "eslint --cache",
    "lint:types": "tsc --build test/tsconfig.json",
    "lint:types:go": "tsgo --build test/tsconfig.json",
    "lint": "nr format:check && nr lint:types:go && nr lint:eslint",
    "lint:fix": "nr format:fix && nr lint:eslint:fix",
    "knip": "knip --no-progress",
    "t": "vitest",
    "t:ui": "vitest --ui",
    "t:cov": "vitest --coverage",
    "test:vitest": "nr t run",
    "test:vitest:cov": "nr t:cov run",
    "test:quick": "nr knip && nr spellcheck && nr lint && nr build:test",
    "test": "nr deps:check && nr test:quick && nr test:vitest:cov",
    "build": "tsdown --clean",
    "build:test": "tsdown --out-dir temp/dist",
    "prepublishOnly": "nr build"
  },
  "devDependencies": {
    "@antfu/ni": "30.1.0",
    "@arethetypeswrong/core": "0.18.2",
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "@commitlint/types": "21.0.1",
    "@eslint/config-inspector": "3.0.3",
    "@types/node": "22.19.17",
    "@typescript/native-preview": "7.0.0-dev.20260524.1",
    "@vitest/coverage-v8": "4.1.7",
    "@vitest/eslint-plugin": "1.6.18",
    "@vitest/ui": "4.1.7",
    "cspell": "10.0.0",
    "es-toolkit": "1.47.0",
    "eslint": "10.4.0",
    "eslint-config-un": "1.0.0-beta.12",
    "jest-extended": "7.0.0",
    "knip": "6.14.2",
    "lefthook": "2.1.8",
    "npm-check-updates": "22.2.1",
    "prettier": "3.8.3",
    "publint": "0.3.21",
    "semver": "7.8.1",
    "tsdown": "0.22.0",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.3.0"
    }
  }
}