{
  "name": "unutils",
  "version": "0.1.0",
  "description": "A big collection of utilities coming from different utility libraries and us, targeting modern environments.",
  "keywords": [
    "utils",
    "util",
    "utilities",
    "utility",
    "stdlib",
    "es-toolkit"
  ],
  "homepage": "https://github.com/andreww2012/unutils",
  "bugs": {
    "url": "https://github.com/andreww2012/unutils/issues/new"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreww2012/unutils.git"
  },
  "license": "MIT",
  "author": "andreww2012",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./array": {
      "types": "./dist/array/index.d.mts",
      "default": "./dist/array/index.mjs"
    },
    "./async": {
      "types": "./dist/async/index.d.mts",
      "default": "./dist/async/index.mjs"
    },
    "./dom": {
      "types": "./dist/dom/index.d.mts",
      "default": "./dist/dom/index.mjs"
    },
    "./dom/query-selector-typed.global": {
      "types": "./dist/dom/query-selector-typed.global.d.mts",
      "default": "./dist/dom/query-selector-typed.global.mjs"
    },
    "./dom/query-selector-typed-strict.global": {
      "types": "./dist/dom/query-selector-typed-strict.global.d.mts",
      "default": "./dist/dom/query-selector-typed-strict.global.mjs"
    },
    "./function": {
      "types": "./dist/function/index.d.mts",
      "default": "./dist/function/index.mjs"
    },
    "./id": {
      "types": "./dist/id/index.d.mts",
      "default": "./dist/id/index.mjs"
    },
    "./iterable": {
      "types": "./dist/iterable/index.d.mts",
      "default": "./dist/iterable/index.mjs"
    },
    "./json": {
      "types": "./dist/json/index.d.mts",
      "default": "./dist/json/index.mjs"
    },
    "./map": {
      "types": "./dist/map/index.d.mts",
      "default": "./dist/map/index.mjs"
    },
    "./math": {
      "types": "./dist/math/index.d.mts",
      "default": "./dist/math/index.mjs"
    },
    "./misc": {
      "types": "./dist/misc/index.d.mts",
      "default": "./dist/misc/index.mjs"
    },
    "./object": {
      "types": "./dist/object/index.d.mts",
      "default": "./dist/object/index.mjs"
    },
    "./predicate": {
      "types": "./dist/predicate/index.d.mts",
      "default": "./dist/predicate/index.mjs"
    },
    "./regex": {
      "types": "./dist/regex/index.d.mts",
      "default": "./dist/regex/index.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.mts",
      "default": "./dist/runtime/index.mjs"
    },
    "./server": {
      "types": "./dist/server/index.d.mts",
      "default": "./dist/server/index.mjs"
    },
    "./set": {
      "types": "./dist/set/index.d.mts",
      "default": "./dist/set/index.mjs"
    },
    "./string": {
      "types": "./dist/string/index.d.mts",
      "default": "./dist/string/index.mjs"
    },
    "./traverse": {
      "types": "./dist/traverse/index.d.mts",
      "default": "./dist/traverse/index.mjs"
    },
    "./ts": {
      "types": "./dist/ts/index.d.mts",
      "default": "./dist/ts/index.mjs"
    },
    "./types": {
      "types": "./dist/types/index.d.mts",
      "default": "./dist/types/index.mjs"
    },
    "./value": {
      "types": "./dist/value/index.d.mts",
      "default": "./dist/value/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "count-exports": "node scripts/count-exports.ts",
    "contrib:add": "all-contributors add",
    "contrib:gen": "all-contributors generate",

    "u": "ncu",
    "u:m": "ncu -t minor",
    "u:pm": "ncu --dep packageManager",
    "u:actions": "actions-up",
    "deps:audit": "pnpm audit --audit-level high",
    "deps:audit:fix": "nr deps:audit --fix override",
    "deps:audit:fix:update": "nr deps:audit --fix update",
    "check:deps:dedupe": "pnpm dedupe --check",
    "check:deps:peers": "pnpm peers check",
    "check:spelling": "cspell --no-progress --no-summary .",
    "check:format": "prettier --check . --log-level warn",
    "format": "prettier --write . --log-level warn",
    "eslint:inspect": "eslint-config-inspector --open false",
    "eslint": "cross-env NODE_OPTIONS='--max-old-space-size=6144' eslint --cache",
    "ts": "tsc --noEmit",
    "ts6": "tsc6 --noEmit",
    "knip:main": "knip --no-progress",
    "knip:cycles": "knip --no-progress --cycles --reporter cycles",
    "knip": "nr \"/^knip:.+$/\"",
    "check": "nr \"/^(knip|check:(spelling|format)|ts|eslint)$/\"",
    "check:deps": "nr \"/^(deps:audit|check:deps:peers)$/\"",
    "check:deps:strict": "nr \"/^(deps:audit|check:deps:(?!strict).+)$/\"",
    "check:fix": "nr format && nr eslint --fix && nr format",
    "t": "vitest",
    "t:ui": "vitest --ui",
    "t:cov": "vitest --coverage",
    "test:vitest": "nr t run",
    "test:vitest:cov": "nr t:cov run",
    "test:types:consumer": "vitest run --config test/published-dts/vitest.config.ts",
    "test": "nr check:deps && nr check && nr build && nr test:types:consumer && nr test:vitest:cov",
    "ch": "changeset add --message \"___REPLACE_ME___\"",
    "release": "changeset publish",
    "build": "tsdown --clean",
    "build:test": "tsdown --out-dir temp/dist",
    "prepublishOnly": "nr build && node scripts/generate-third-party-notices.ts"
  },
  "devDependencies": {
    "@antfu/ni": "30.5.0",
    "@antfu/utils": "9.3.0",
    "@arethetypeswrong/core": "0.18.5",
    "@changesets/cli": "2.31.1",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@commitlint/types": "21.2.0",
    "@eslint/config-inspector": "3.2.0",
    "@types/node": "22.19.17",
    "@types/yieldable-json": "2.0.2",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/eslint-plugin": "1.6.27",
    "@vitest/ui": "4.1.10",
    "actions-up": "1.17.0",
    "all-contributors-cli": "6.27.0-rc.1",
    "arkregex": "0.0.8",
    "cleye": "2.6.0",
    "cross-env": "10.1.0",
    "cspell": "10.0.1",
    "dedent": "1.7.2",
    "destr": "2.0.5",
    "devalue": "5.8.1",
    "es-toolkit": "1.49.0",
    "eslint": "10.8.1",
    "eslint-config-un": "1.0.0-beta.16",
    "eslint-plugin-github-action": "0.3.0",
    "eslint-plugin-remeda": "2.2.0",
    "happy-dom": "20.11.2",
    "jest-extended": "7.0.0",
    "knip": "6.32.1",
    "lefthook": "2.1.10",
    "lossless-json": "4.3.0",
    "ms-ts": "1.0.0",
    "nanoid": "6.0.0",
    "neotraverse": "1.0.1",
    "npm-check-updates": "23.0.2",
    "prettier": "3.9.6",
    "publint": "0.3.23",
    "remeda": "2.39.0",
    "safe-stable-stringify": "2.5.0",
    "semver": "7.8.5",
    "string-ts": "2.3.1",
    "ts-extras": "1.2.0",
    "tsdown": "0.22.14",
    "type-fest": "5.8.0",
    "typed-query-selector": "2.12.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-7": "npm:typescript@7.0.2",
    "valibot": "1.4.2",
    "vitest": "4.1.10",
    "yieldable-json": "2.1.0"
  },
  "engines": {
    "node": "^22.23.1 || >=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0"
    }
  }
}